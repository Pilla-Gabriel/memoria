# Copie este arquivo para .env e preencha os valores.

# Banco de dados local (SQLite)
DATABASE_URL="file:./dev.db"

# Chave usada pelo NextAuth para assinar sessões — gere uma com:
# openssl rand -base64 32
AUTH_SECRET=

# Integração com Azure DevOps — opcional. Sem essas variáveis, o app
# funciona normalmente com atualização manual de números em Entrega Semanal.
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=

# Mostra o bloco de contas de demonstração na tela de login (apenas fora de
# produção). Deixe em branco/ausente para manter oculto.
SHOW_DEV_CREDENTIALS=

# Hosts extras liberados para acessar o servidor de dev (separados por vírgula).
# Necessário para abrir o app em npm run dev a partir de outro dispositivo na
# rede/VPN em vez de localhost — ex: DEV_ALLOWED_ORIGINS=192.168.0.108
DEV_ALLOWED_ORIGINS=

# Notificações de área de trabalho (Web Push) — opcional. Sem essas
# variáveis, os alertas continuam existindo só dentro do app (sininho). Gere
# um par com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# E-mail de contato exigido pelo protocolo Web Push (identifica o remetente
# pros serviços de push do navegador — Google/Mozilla/Microsoft). Não precisa
# ser real nem monitorado.
VAPID_SUBJECT=mailto:contato@onclick.com.br

# HTTPS opcional (certificado autoassinado) — necessário para notificações de
# área de trabalho funcionarem fora de localhost: navegadores só expõem
# Service Worker/Notification/PushManager em contexto seguro (HTTPS). Gere com:
#   powershell -ExecutionPolicy Bypass -File .\scripts\setup-https-cert.ps1
# Deixe em branco para rodar só em HTTP (push fica indisponível fora de localhost).
HTTPS_PORT=443
HTTPS_PFX_PATH=
HTTPS_PFX_PASSPHRASE=
